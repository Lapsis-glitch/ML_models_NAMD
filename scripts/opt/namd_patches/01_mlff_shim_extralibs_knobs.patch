+ *   NAMD_MLFF_TF32=1              allow TF32 in cuBLAS/cuDNN (changes fp32 numerics!) */
+int envFlag(const char *name) {           /* -1 = unset, else 0/1 */
+    const char *v = std::getenv(name);
+    if (!v || !*v) return -1;
+    return (v[0] == '0' || v[0] == 'n' || v[0] == 'N' || v[0] == 'f' || v[0] == 'F') ? 0 : 1;
+}
+int g_jitOptimize = -1;
+void applyGlobalKnobs() {
+    static std::once_flag once;
+    std::call_once(once, [] {
+        std::string summary;
+        int prof = envFlag("NAMD_MLFF_JIT_PROFILING");
+        if (prof >= 0) {
+            torch::jit::getExecutorMode() = (prof != 0);
+            torch::jit::getProfilingMode() = (prof != 0);
+            summary += " JIT_PROFILING=" + std::to_string(prof);
+        }
+        g_jitOptimize = envFlag("NAMD_MLFF_JIT_OPTIMIZE");
+        if (g_jitOptimize >= 0) summary += " JIT_OPTIMIZE=" + std::to_string(g_jitOptimize);
+        int te = envFlag("NAMD_MLFF_JIT_TEXPR");
+        if (te >= 0) {
+            torch::jit::setTensorExprFuserEnabled(te != 0);
+            summary += " JIT_TEXPR=" + std::to_string(te);
+        }
+        if (const char *fs = std::getenv("NAMD_MLFF_JIT_FUSION")) {
+            torch::jit::FusionStrategy strat;
+            std::string str(fs);
+            size_t pos = 0;
+            while (pos < str.size()) {
+                size_t end = str.find(',', pos);
+                if (end == std::string::npos) end = str.size();
+                std::string item = str.substr(pos, end - pos);
+                pos = end + 1;
+                size_t c = item.find(':');
+                if (c == std::string::npos) continue;
+                std::string kind = item.substr(0, c);
+                size_t depth = std::strtoul(item.c_str() + c + 1, nullptr, 10);
+                if (kind == "STATIC" || kind == "static")
+                    strat.emplace_back(torch::jit::FusionBehavior::STATIC, depth);
+                else if (kind == "DYNAMIC" || kind == "dynamic")
+                    strat.emplace_back(torch::jit::FusionBehavior::DYNAMIC, depth);
+            }
+            if (!strat.empty()) {
+                torch::jit::setFusionStrategy(strat);
+                summary += std::string(" JIT_FUSION=") + fs;
+            }
+        }
+        if (const char *nr = std::getenv("NAMD_MLFF_JIT_PROFILED_RUNS")) {
+            torch::jit::getNumProfiledRuns() = std::strtoul(nr, nullptr, 10);
+            summary += std::string(" JIT_PROFILED_RUNS=") + nr;
+        }
+        int tf32 = envFlag("NAMD_MLFF_TF32");
+        if (tf32 >= 0) {
+            at::globalContext().setAllowTF32CuBLAS(tf32 != 0);
+            at::globalContext().setAllowTF32CuDNN(tf32 != 0);
+            summary += " TF32=" + std::to_string(tf32);
+        }
+        if (envFlag("NAMD_MLFF_FREEZE") >= 0)
+            summary += " FREEZE=" + std::to_string(envFlag("NAMD_MLFF_FREEZE"));
+        if (!summary.empty())
+            std::fprintf(stderr, "MLFF shim: runtime knobs:%s\n", summary.c_str());
+    });
+}
+/* setGraphExecutorOptimize is thread-local and NAMD evaluates on a worker
+ * thread, so it is (re)applied on the evaluating thread each call. */
+inline void applyThreadKnobs() {
+    if (g_jitOptimize >= 0) torch::jit::setGraphExecutorOptimize(g_jitOptimize != 0);
+}
+
+/* NAMD_MLFF_EXTRA_LIBS: colon-separated list of shared libraries that
+ * register TorchScript custom ops (cuEquivariance, TorchANI cuAEV, vesin,
+ * OpenEquivariance, ...).  Each is dlopen'd RTLD_NOW|RTLD_GLOBAL before
+ * torch::jit::load so the ops exist when the archive is deserialized.  The
+ * handles are intentionally never closed (op registrations must outlive every
+ * model).  Re-dlopen of an already-loaded path is a cheap refcount bump, so
+ * calling this on every load is fine.  Returns false and sets `err` on the
+ * first library that fails to load. */
+bool loadExtraLibs(std::string &err) {
+    const char *env = std::getenv("NAMD_MLFF_EXTRA_LIBS");
+    if (!env || !*env) return true;
+    /* NAMD dlopens this shim RTLD_LOCAL, so libtorch's own libraries are not
+     * in the global symbol scope.  Op libraries whose NEEDED list is
+     * incomplete (e.g. libtorch_nvshmem.so from a pip wheel needs c10_cuda
+     * symbols but only lists libc10.so) would then fail with an undefined
+     * symbol.  Promote the already-loaded libtorch libraries to global scope
+     * first; RTLD_NOLOAD never loads anything new. */
+    static const char *const kTorchLibs[] = {
+        "libc10.so", "libc10_cuda.so", "libtorch_cpu.so", "libtorch_cuda.so",
+        "libtorch.so"};
+    for (const char *lib : kTorchLibs)
+        ::dlopen(lib, RTLD_NOW | RTLD_GLOBAL | RTLD_NOLOAD);
+    std::string list(env);
+    size_t pos = 0;
+    while (pos <= list.size()) {
+        size_t end = list.find(':', pos);
+        if (end == std::string::npos) end = list.size();
+        std::string path = list.substr(pos, end - pos);
+        pos = end + 1;
+        if (path.empty()) continue;
+        if (!::dlopen(path.c_str(), RTLD_NOW | RTLD_GLOBAL)) {
+            const char *de = ::dlerror();
+            err = "NAMD_MLFF_EXTRA_LIBS: dlopen(" + path + ") failed: " +
+                  (de ? de : "unknown error");
+            return false;
+        }
+    }
+    return true;
+}
