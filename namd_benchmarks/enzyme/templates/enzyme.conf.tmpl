# ===========================================================================
# NAMD3 full-ML enzyme benchmark — templated config.
# The WHOLE solvated enzyme droplet is the QM/ML region (beta=1 for every atom).
# qmReplaceAll is a knob (@QMREPLACEALL@, default off — set via run_enzyme.sh):
#   off -> bypasses NAMD's buggy multi-patch replaceForces scatter (ROOTCAUSE doc),
#          so the ML forces are applied correctly and dynamics stay stable for timing;
#   on  -> the historical "engine supplies ALL forces" mode, which CRASHES on
#          multi-patch ML regions until the one-line ComputeQM.C fix lands.
# Finite, non-periodic cluster (no PBC / PME) — the
# system.prmtop has its box stripped, matching the fixed-shape FeNNiX export.
# Placeholders are substituted by run_enzyme.sh.
# ===========================================================================

amber                   yes
parmfile                @PRMTOP@
coordinates             @COORDS@
temperature             300

# --- output / timing -------------------------------------------------------
binaryoutput            no
outputname              @OUTPUTNAME@
outputenergies          @OUTPUTFREQ@
outputtiming            @OUTPUTFREQ@
outputpressure          0
binaryrestart           no
restartfreq             1000000
dcdfreq                 1000000

# --- (MM forces are discarded by qmReplaceAll; kept valid for startup) ------
cutoff                  12.0
pairlistdist            14.0
switching               on
switchdist              10.0
exclude                 scaled1-4
1-4scaling              0.833333
rigidbonds              all

# --- thermostat ------------------------------------------------------------
langevin                on
langevintemp            300
langevinHydrogen        on
langevindamping         5

# --- integrator ------------------------------------------------------------
timestep                @TIMESTEP@
firstTimestep           0
stepspercycle           @STEPSPERCYCLE@
fullElectFrequency      1
nonbondedfreq           1

# --- QM / ML-FF engine -----------------------------------------------------
QMForces                on
QMSoftware              @QMSOFTWARE@
QMExecPath              @QMEXEC@
QMColumn                beta
qmParamPDB              @QMPDB@
QMBaseDir               @QMBASEDIR@
QMChargeMode            none
qmBondColumn            occ
QMSimsPerNode           1
qmReplaceAll            @QMREPLACEALL@
QMVdWParams             off
qmElecEmbed             off
QMSwitching             off
QMPointChargeScheme     none
QMMult                  1 1
QMCharge                1 @QMCHARGE@
@EXTRA@

run                     @STEPS@
